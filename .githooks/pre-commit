#!/bin/sh
# Format and lint staged Python files with ruff before each commit.
# Enable once per clone: git config core.hooksPath .githooks
set -eu

# Vendor and instrument material must never be committed, even with `git add -f`.
# Deletions are fine: they are how material leaves the repository.
evidence=$(git -c core.quotePath=false diff --cached --name-only --diff-filter=ACMR -- "autosuite" \
    ":(exclude)autosuite/README.md" ":(exclude)autosuite/docs" \
    ":(exclude)autosuite/recipe" ":(exclude)autosuite/schema" ":(exclude)autosuite/tools")
if [ -n "$evidence" ]; then
    printf "pre-commit: refusing to commit AutoSuite evidence; see autosuite/README.md:\n%s\n" "$evidence" >&2
    exit 1
fi

staged=$(git -c core.quotePath=false diff --cached --name-only --diff-filter=ACMR -- "*.py" "*.pyi")
[ -n "$staged" ] || exit 0

IFS="
"
set -- $staged
unset IFS

unstaged=$(git -c core.quotePath=false diff --name-only -- "$@")
if [ -n "$unstaged" ]; then
    printf "pre-commit: these staged Python files also have unstaged changes; stage or stash them first:\n%s\n" "$unstaged" >&2
    exit 1
fi

uv run --frozen --quiet ruff check --fix-only --quiet -- "$@"
uv run --frozen --quiet ruff format --quiet -- "$@"
git add -- "$@"

if ! uv run --frozen --quiet ruff check --quiet -- "$@"; then
    printf "pre-commit: ruff reported errors it cannot fix; resolve them and commit again.\n" >&2
    exit 1
fi
