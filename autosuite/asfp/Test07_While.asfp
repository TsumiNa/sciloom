<?xml version="1.0" encoding="utf-8"?>
<functions>
  <function typeid="Chemspeed.SATaskFunctionDefinition.1">
    <name>TEST07_WHILE</name>
    <description />
    <functionid>{01A56325-6786-4A71-A8E3-48CB11A30CFD}</functionid>
    <functiondata>
      <inputs><count>0</count></inputs>
      <outputs><count>0</count></outputs>
    </functiondata>
    <components>
      <component typeid="Chemspeed.SAMacroTask.1">
        <name>TEST07_WHILE</name>
        <description />
        <variables>
          <count>1</count>
          <item0>
            <variablename>x</variablename>
            <variabletype>real number</variabletype>
            <isarray>0</isarray>
            <value>0</value>
          </item0>
        </variables>
        <conditionloop>1</conditionloop>
        <conditiontype>0</conditiontype>
        <loopvariable>loop</loopvariable>
        <multicondition>0</multicondition>
        <tasks>
          <count>1</count>
          <task typeid="Chemspeed.SAMacroTask.1">
            <name>TEST07_WHILE_Block</name>
            <description />
            <variables><count>0</count></variables>
            <conditionloop>1</conditionloop>
            <conditionwhile>x &lt; 1</conditionwhile>
            <conditiontype>2</conditiontype>
            <loopvariable>loop</loopvariable>
            <multicondition>0</multicondition>
            <tasks>
              <count>1</count>
              <task typeid="Chemspeed.SATaskSetVariable.1">
                <name>Set Variable</name>
                <variablename>x</variablename>
                <expressiontext>x + 1</expressiontext>
              </task>
            </tasks>
          </task>
        </tasks>
      </component>
    </components>
  </function>
