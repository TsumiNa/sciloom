# Python and local environments
__pycache__/
*.py[cod]
.venv/
.uv-cache/
*.egg-info/

# Build and test outputs
/build/
/dist/
/.build/
/.cache/
/website/.build/
/website/.cache/
/website/docs/_generated/
/website/docs/build-info.json
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Local settings and secrets
.DS_Store
.env
.env.*
!.env.example

# AutoSuite material from the vendor and the instruments never enters git: the
# repository must stay publishable. Deny the whole directory and re-allow only
# what this project writes, so material added later is excluded by default.
/autosuite/*
!/autosuite/README.md
!/autosuite/docs/
!/autosuite/recipe/
!/autosuite/schema/
!/autosuite/tools/
